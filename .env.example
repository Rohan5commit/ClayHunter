# Required in live mode
BID_MODE=paper
BID_API_URL=https://api.bid.example
BID_WS_URL=wss://api.bid.example/agent/events
BID_ACCESS_CODE=
BID_API_KEY=
BID_PRIVATE_KEY=
BID_AGENT_ID=clayhunter

# Risk and bankroll
CLAY_STARTING_BANKROLL_USD=1000
CLAY_MAX_ROUND_CAPITAL_PCT=0.18
CLAY_MAX_ORDER_USD=50
CLAY_MIN_ORDER_USD=2
CLAY_DAILY_DRAWDOWN_PCT=0.12
CLAY_SESSION_DRAWDOWN_PCT=0.08
CLAY_LOSS_STREAK_LIMIT=3
CLAY_DOWNSHIFT_MULTIPLIER=0.5
CLAY_STALE_MARKET_MS=2500
CLAY_KILL_SWITCH_ENABLED=true

# Signal thresholds
CLAY_MOMENTUM_CONFIDENCE=0.62
CLAY_FADE_CONFIDENCE=0.66
CLAY_ENDGAME_SECONDS=35
CLAY_OBSERVE_SECONDS=30
CLAY_ACTIVE_SECONDS=180
CLAY_LOG_LEVEL=info
CLAY_DATA_DIR=.clayhunter
